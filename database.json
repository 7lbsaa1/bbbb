{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)"
      }
    },
    "posts": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["createdAt", "userId"]
    },
    "reactions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "comments": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "reports": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
